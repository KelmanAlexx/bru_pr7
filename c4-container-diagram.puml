@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam rectangle {
  BackgroundColor #F7FAFC
  BorderColor #52718A
}
skinparam packageStyle rectangle

actor "Студент / выпускник" as Student
actor "Специалист центра карьеры" as Specialist

rectangle "АИС «Центр карьеры и трудоустройства»" {
  component "Клиентское приложение\n[Container: WPF / C#]\nИнтерфейс студента и специалиста" as Client
  component "Интеграционный шлюз\n[Container: ASP.NET Core Web API / C#]\nREST, авторизация, проверка данных,\nобработка вакансий и откликов" as Gateway
  component "Сервис синхронизации\n[Container: Background Worker / C#]\nПолучает и обновляет вакансии партнёров" as Worker
  database "База данных\n[Container: PostgreSQL]\nПользователи, резюме, вакансии, отклики" as DB
}

component "Платформы работодателей\n[Внешние REST API]\nВакансии и приём откликов" as Employers

Student --> Client : работает с интерфейсом
Specialist --> Client : работает с интерфейсом
Client --> Gateway : HTTPS / REST / JSON
Gateway --> DB : чтение и запись
Worker --> DB : обновление каталога
Worker --> Employers : получает актуальные вакансии
Gateway --> Employers : передаёт отклики
@enduml
